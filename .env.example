# TravelNeko 环境变量模板

# ---- 必填 ----
# 任意 OpenAI 兼容服务的 API Key。缺失会导致 /api/* 返回 500。
LLM_API_KEY=YOUR_KEY

# ---- 模型服务（默认对接 OpenAI；接其他服务只需改下面的地址与模型名）----
DEFAULT_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_VISION_MODEL=gpt-4o
DEFAULT_IMAGE_MODEL=dall-e-3

# ---- 功能开关 ----
# 明信片配图生成（会调用图像模型），默认关闭。
ENABLE_IMAGE_GENERATION=false
# 剧情导演 Agent：每轮判断是否触发剧情。
# 设为 "false" 则退回到确定性的规则挑选（不调用导演）。
ENABLE_PLOT_DIRECTOR=true

# ---- 可选覆盖项（都有合理默认值，一般不用改）----
# HTTP 请求超时（毫秒，默认 120000）。
# LLM_TIMEOUT_MS=120000
# 存储路径（默认在 ./data 与 ./content 下）。
# JOURNAL_PATH=./data/journals.json
# GAME_STATE_PATH=./data/game-state.json
# CHAT_SESSIONS_PATH=./data/chat-sessions.json
# PLOTS_DIR=./content/plots
